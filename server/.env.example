# ─── Kabba Designs Server — environment variables ───────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, or local Postgres).
# Create a free Neon DB at https://neon.tech or via the Vercel Marketplace:
#   Vercel dashboard → Storage → Create → Neon Postgres
DATABASE_URL=postgresql://user:password@host:5432/kabba_designs?sslmode=require

# Admin login (used by POST /api/admin/login)
ADMIN_EMAIL=admin@kabba.com
ADMIN_PASSWORD=change-me

# JWT signing secret (any long random string)
JWT_SECRET=change-me

# Vercel Blob token for product/event image uploads.
# Create a Blob store: Vercel dashboard → Storage → Create → Blob,
# then copy the "Read & Write Token".
# Works from any Node server — not only Vercel Functions.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Order email notifications (nodemailer with a Gmail app password)
NOTIFY_EMAIL=you@gmail.com
NOTIFY_EMAIL_PASS=your-app-password

# Chapa payment gateway
CHAPA_SECRET=chsec_...
# URL of your backend webhook (required for payment confirmations)
CHAPA_CALLBACK_URL=https://your-api.example.com/api/chapa/webhook
# Where Chapa returns the customer after payment (your frontend)
CHAPA_RETURN_URL=https://your-site.vercel.app/success

# development | production
NODE_ENV=development
