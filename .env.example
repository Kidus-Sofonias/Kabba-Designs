# Kabba Designs frontend environment variables
# Copy this file to .env.local for local development, or set these
# in the Vercel project dashboard (Settings -> Environment Variables).

# Base URL of the Kabba Designs backend API (no trailing slash).
# If unset, the app falls back to the current production backend.
VITE_API_URL=https://kabba-designs-server.onrender.com/api
